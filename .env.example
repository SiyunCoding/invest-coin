# 로컬 실행용 환경 변수 예시 (값을 채워 셸에서 export / $env:... 로 설정. 코드는 .env 파일을 직접 읽지 않음)
# 서버(GitHub Actions)에서는 repo Settings → Secrets 에 같은 이름으로 등록

# Binance Spot Testnet (https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance Mainnet — 실거래 전용. 권한: Reading + Spot Trading 만, 출금 OFF, IP 제한 필수
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram 알림 (없으면 알림 생략)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
